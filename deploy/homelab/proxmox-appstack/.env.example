# Copy to .env beside docker-compose.yaml. Never commit the filled-in copy.

# --- CouchDB ---------------------------------------------------------------
# These are also referenced in bridge/config.json -- keep them in sync.
COUCHDB_USER=obsidian
COUCHDB_PASSWORD=

# --- n8n -------------------------------------------------------------------
# Generate once and never change: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# Public hostname Telegram will call. Must resolve publicly and be routable
# to Traefik -- this is the one service with a public route.
N8N_HOST=n8n.example.com

TZ=Europe/Lisbon

# --- Vault -----------------------------------------------------------------
# Path ON THE VM where the TrueNAS vault dataset is NFS-mounted.
# e.g. /etc/fstab: 192.168.1.4:/mnt/tank/vault /mnt/vault nfs defaults,_netdev 0 0
VAULT_MIRROR=/mnt/vault
