# Copy to .env beside docker-compose.yaml.

# Where container state lives. Replace `tank` with your pool name.
APPS_PATH=/mnt/tank/apps

# Whisper model. large-v3 is the accuracy choice and fits easily in 24GB
# alongside Ollama. distil-large-v3 is ~2x faster at a small accuracy cost.
WHISPER_MODEL=Systran/faster-whisper-large-v3
