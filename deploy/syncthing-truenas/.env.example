# Copy to .env next to docker-compose.yaml.
#
# The Traefik/ACME settings that used to live here are gone: Traefik runs on
# Proxmox and owns its own certificate configuration. The hostname for this
# service is set in ../homelab/traefik-routes/20-syncthing.yaml.

# Container config and synced data. Replace `tank` with your pool name.
APPS_PATH=/mnt/tank/apps
SYNC_DATA_PATH=/mnt/tank/sync

# Name shown to peer devices.
SYNCTHING_DEVICE_NAME=truenas

# Owner of the synced files. `apps` is 568:568 on TrueNAS SCALE; match whatever
# owns SYNC_DATA_PATH so Syncthing can write without breaking share ACLs.
PUID=568
PGID=568
