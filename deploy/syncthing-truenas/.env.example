# Copy to .env next to docker-compose.yaml and fill in. Never commit .env --
# it holds the DNS provider API token.

# ---- Hostname -------------------------------------------------------------
# Must live in a DNS zone your ACME provider token can write TXT records to.
# The A record may point at the private address 192.168.1.4; DNS-01 validation
# never connects to the host, so a private A record is fine.
SYNCTHING_HOST=syncthing.example.com

# ---- Let's Encrypt (DNS-01) ----------------------------------------------
ACME_EMAIL=you@example.com

# lego provider code. cloudflare, route53, digitalocean, gandiv5, desec, ...
# Full list: https://doc.traefik.io/traefik/https/acme/#providers
ACME_DNS_PROVIDER=cloudflare

# Credential for the provider above. Each provider reads a DIFFERENT variable
# name -- if you are not on Cloudflare, rename this here AND in the traefik
# `environment:` block of docker-compose.yaml to whatever your provider needs
# (e.g. DO_AUTH_TOKEN, AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY).
# Cloudflare: a scoped API token with Zone:DNS:Edit on the relevant zone.
CF_DNS_API_TOKEN=

# ---- Storage --------------------------------------------------------------
# Container configuration + Traefik state. Replace `tank` with your pool name.
APPS_PATH=/mnt/tank/apps
# The dataset Syncthing actually synchronises.
SYNC_DATA_PATH=/mnt/tank/sync

# ---- Syncthing ------------------------------------------------------------
# Name shown to peer devices.
SYNCTHING_DEVICE_NAME=truenas

# Owner of the synced files. `apps` is 568:568 on TrueNAS SCALE; use the uid/gid
# that owns SYNC_DATA_PATH so Syncthing can write without breaking share ACLs.
PUID=568
PGID=568

# ---- Traefik --------------------------------------------------------------
TRAEFIK_LOG_LEVEL=INFO
